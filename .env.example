# ==============================================================================
# OSV Threat Auditor - Configuración de Entorno (Opcional)
# ==============================================================================
# El motor determinista opera sobre la API pública de OSV.dev (Google/OpenSSF),
# por lo que el sistema base funciona a costo $0 y sin requerir API Keys.

# ------------------------------------------------------------------------------
# 1. Parámetros de Red y Resiliencia (Opcional)
# ------------------------------------------------------------------------------
# Tiempo máximo de espera en segundos para respuestas HTTP de OSV.dev
REQUEST_TIMEOUT_SECONDS=10

# Intentos máximos de reintento exponencial (Backoff) ante errores 429/5xx
MAX_API_RETRIES=3

# ------------------------------------------------------------------------------
# 2. Rutas del Sistema (Opcional)
# ------------------------------------------------------------------------------
# Ruta personalizada al archivo de inventario de dependencias
# INVENTORY_FILE_PATH=data/inventory.json

# Ruta de almacenamiento para la memoria de vulnerabilidades notificadas
# CACHE_FILE_PATH=data/cache.json

# ------------------------------------------------------------------------------
# 3. Integraciones de Notificación Futuras (Opcional)
# ------------------------------------------------------------------------------
# Webhook para alertas en canales de comunicación (Slack / Discord / Teams)
# NOTIFICATION_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
